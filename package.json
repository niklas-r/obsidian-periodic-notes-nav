{
	"name": "obsidian-periodic-notes-nav",
	"version": "0.1.1",
	"description": "A navigation bar for moving between daily, weekly, monthly, quarterly and yearly periodic notes in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "node scripts/run-tests.mjs",
		"test:e2e": "npm run build && wdio run ./wdio.conf.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "node scripts/validate-plugin.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"periodic-notes",
		"daily-notes"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/jsdom": "^30.0.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.4.0",
		"@wdio/cli": "^9.31.3",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.31.3",
		"@wdio/mocha-framework": "^9.31.2",
		"builtin-modules": "^5.3.0",
		"chai": "^5.3.3",
		"esbuild": "0.28.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"mocha": "^10.8.2",
		"moment": "2.30.1",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"tsx": "^4.23.12",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.68.0",
		"wdio-obsidian-reporter": "^3.2.0",
		"wdio-obsidian-service": "^3.2.0"
	},
	"overrides": {
		"deepmerge-ts": "^8.0.2",
		"serialize-javascript": "^7.1.0",
		"@puppeteer/browsers": "^3.2.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"classic-level@3.0.0": true,
		"edgedriver@6.3.0": false,
		"geckodriver@6.1.1": false
	}
}
