{
	"name": "obsidian-periodic-notes-nav",
	"version": "0.1.0",
	"description": "A navigation bar for moving between daily, weekly, monthly, quarterly and yearly periodic notes in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "node scripts/run-tests.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "node scripts/validate-plugin.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"periodic-notes",
		"daily-notes"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^22.10.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "0.24.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"moment": "2.30.1",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"typescript": "5.7.2",
		"typescript-eslint": "^8.68.0"
	},
	"allowScripts": {
		"esbuild@0.24.2": true
	}
}
