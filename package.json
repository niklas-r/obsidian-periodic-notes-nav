{
  "name": "obsidian-periodic-notes-nav",
  "version": "0.1.0",
  "description": "A navigation bar for moving between daily, weekly, monthly, quarterly and yearly periodic notes in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node scripts/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "periodic-notes",
    "daily-notes"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "0.24.2",
    "jsdom": "^30.0.1",
    "moment": "2.30.1",
    "obsidian": "latest",
    "typescript": "5.7.2"
  }
}
